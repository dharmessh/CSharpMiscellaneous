using System;
using System.Globalization;

namespace Practice
{
    internal class Program
    {
        public static void Main()
        {
            // Sample Array of Integers
            int[] sampleArr = { 2, 0, 2, 1, 1, 0 };
            int[] sampleArrB = { 2, 0, 2, 1, 1, 0, 0, 0, 0, 2 };

            SortColours(sampleArr);
            DutchNationalFlagAlgorithm(sampleArrB);

            foreach (var element in sampleArrB)
            {
                Console.WriteLine(element);
